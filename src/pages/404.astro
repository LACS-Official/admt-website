---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
---

<MainLayout
  title={`404 - 页面未找到 | ${SITE_CONFIG.name}`}
  description="抱歉，您访问的页面不存在或已被移除。"
  noindex={true}
>
  <div
    class="min-h-[75vh] flex items-center justify-center bg-white dark:bg-black px-4 sm:px-6 lg:px-8 py-20 relative overflow-hidden"
  >
    <!-- Background subtle glow -->
    <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
      <div
        class="w-96 h-96 rounded-full bg-blue-500/5 dark:bg-blue-600/10 blur-[120px]"
      ></div>
    </div>

    <div class="max-w-xl w-full text-center relative z-10">
      <!-- 404 Badge -->
      <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-gray-100 dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-semibold tracking-wider mb-6">
        <span>ERROR 404</span>
      </div>

      <!-- Main Headline -->
      <h1
        class="text-6xl sm:text-8xl font-extrabold text-gray-900 dark:text-white tracking-tighter mb-4"
      >
        404
      </h1>

      <h2
        class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-gray-100 tracking-tight mb-4"
        data-i18n-key="notFoundTitle"
      >
        页面未找到
      </h2>

      <p
        class="text-base sm:text-lg text-gray-500 dark:text-gray-400 font-light max-w-md mx-auto mb-10 leading-relaxed"
        data-i18n-key="notFoundSubtitle"
      >
        抱歉，您访问的页面不存在、已被移除或链接地址有误。
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center">
        <a
          href="/"
          class="w-full sm:w-auto px-7 py-3 rounded-xl bg-black dark:bg-white text-white dark:text-black font-semibold text-sm sm:text-base hover:scale-[1.02] active:scale-95 transition-all shadow-md"
          data-i18n-key="notFoundBackHome"
        >
          返回首页
        </a>
        <a
          href="/docs"
          class="w-full sm:w-auto px-7 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700 font-semibold text-sm sm:text-base hover:bg-gray-200 dark:hover:bg-gray-700 active:scale-95 transition-all"
          data-i18n-key="notFoundDocs"
        >
          查看文档
        </a>
        <a
          href="/download"
          class="w-full sm:w-auto px-7 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700 font-semibold text-sm sm:text-base hover:bg-gray-200 dark:hover:bg-gray-700 active:scale-95 transition-all"
          data-i18n-key="notFoundDownload"
        >
          前往下载
        </a>
      </div>
    </div>
  </div>
</MainLayout>
