---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import VersionHistory from "@/components/VersionHistory.astro";
import { softwareVersionApi } from "@/services/versionApi";

// Fetch dynamic data at build/request time
const dynamicConfig = await softwareVersionApi.generateDynamicDownloadConfig();
const latestVersion = dynamicConfig?.version || "1.3.1";
const downloads = dynamicConfig?.allDownloadLinks || {};
const versions = dynamicConfig?.allVersions || [];

const { downloadPage } = SITE_CONFIG;
const { platforms } = downloadPage;
---

<MainLayout
  title={`下载 - ${SITE_CONFIG.name}`}
  description={`下载 ${SITE_CONFIG.name} (${SITE_CONFIG.englishName})，支持 Windows、macOS 和 Linux。立即开始管理您的设备。`}
>
  <!-- Latest Version Showcase -->
  <section
    class="py-16 md:py-32 bg-white dark:bg-black border-b border-gray-100 dark:border-gray-800 relative"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-10">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center space-x-2 px-4 py-1.5 rounded bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-gray-700 dark:text-gray-300 text-sm font-medium mb-8 mx-auto"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-black dark:bg-white"
            ></span>
          </span>
          <span
            >{downloadPage.hero.versionReadyPrefix || "最新版本 "}{
              latestVersion
            }{downloadPage.hero.versionReadySuffix || " 已就绪"}</span
          >
        </div>
        <h1
          class="text-4xl md:text-7xl lg:text-8xl font-bold text-gray-900 dark:text-white mb-6 md:mb-8 tracking-tighter"
        >
          {downloadPage.hero.title.replace("{SITE_CONFIG.name}", "")}
          <span class="text-gray-400 font-light">{SITE_CONFIG.name}</span>
        </h1>
        <p
          class="text-lg md:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto font-light mb-10 md:mb-12"
        >
          {downloadPage.hero.subtitle}
        </p>

        <!-- Dynamic Download Buttons -->
        <div class="flex flex-wrap justify-center gap-4 max-w-3xl mx-auto">
          {
            downloads.quark && (
              <a
                href={downloads.quark}
                target="_blank"
                class="group relative px-8 py-3 bg-[#006CFF] text-white rounded-xl font-medium text-base hover:bg-[#005AE0] transition-colors flex items-center gap-2"
              >
                <img
                  src={downloadPage.providerIcons.quark}
                  alt="Quark"
                  class="w-5 h-5 object-contain"
                />
                夸克网盘下载
              </a>
            )
          }
          {
            downloads.thunderPan && (
              <a
                href={downloads.thunderPan}
                target="_blank"
                class="px-8 py-3 bg-[#1F4CFF] text-white rounded-xl font-medium text-base hover:bg-[#163FD9] transition-colors flex items-center gap-2"
              >
                <img
                  src={downloadPage.providerIcons.thunderPan}
                  alt="Thunder"
                  class="w-5 h-5 object-contain"
                />
                迅雷网盘下载
              </a>
            )
          }
          {
            downloads.baidu && (
              <a
                href={downloads.baidu}
                target="_blank"
                class="px-8 py-3 bg-gray-900 dark:bg-white dark:text-black text-white rounded-xl font-medium text-base hover:bg-black dark:hover:bg-gray-100 transition-colors flex items-center gap-2"
              >
                <img
                  src={downloadPage.providerIcons.baidu}
                  alt="Baidu"
                  class="w-5 h-5 object-contain"
                />
                百度网盘下载
              </a>
            )
          }
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-6xl mx-auto"
      >
        <!-- Windows Platform -->
        <div
          class="p-8 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800"
        >
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">
              {platforms.windows.name}
            </h2>
            <span
              class="text-xs text-gray-500 dark:text-gray-400 ml-auto border border-gray-200 dark:border-gray-700 px-2 py-1 rounded"
              >{platforms.windows.requirement}</span
            >
          </div>
          <div class="space-y-3">
            {
              (platforms.windows.items || []).map((item: string) => (
                <div class="p-4 rounded-lg bg-white dark:bg-black border border-gray-100 dark:border-gray-800 text-sm font-medium text-gray-800 dark:text-gray-200">
                  {item}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Linux Platform (Poll) -->
        <div
          class="p-8 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 flex flex-col"
        >
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">
              {platforms.linux.name}
            </h2>
            <span
              class="text-xs text-gray-500 dark:text-gray-400 ml-auto border border-gray-200 dark:border-gray-700 px-2 py-1 rounded"
              >{platforms.linux.requirement}</span
            >
          </div>
          <div class="mt-auto space-y-4">
            <div
              class="p-4 rounded-lg bg-white dark:bg-black border border-gray-100 dark:border-gray-800 text-center"
            >
              <p class="text-sm font-medium text-gray-800 dark:text-gray-200">
                {platforms.linux.statusText}
              </p>
            </div>
            <button
              id="linux-poll-button"
              class="w-full py-3 rounded-lg bg-black dark:bg-white text-white dark:text-black font-medium text-sm transition-colors hover:bg-gray-800 dark:hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {platforms.linux.pollButtonText}
            </button>
            <div class="text-center pt-2">
              <p class="text-xs text-gray-500">
                {platforms.linux.pollPrefix || "已有 "}<span
                  id="linux-poll-count"
                  class="font-bold">...</span
                >{platforms.linux.pollSuffix || " 位用户支持"}
              </p>
            </div>
          </div>
        </div>

        <!-- macOS Platform (Poll) -->
        <div
          class="p-8 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 flex flex-col"
        >
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">
              {platforms.macos.name}
            </h2>
            <span
              class="text-xs text-gray-500 dark:text-gray-400 ml-auto border border-gray-200 dark:border-gray-700 px-2 py-1 rounded"
              >{platforms.macos.requirement}</span
            >
          </div>
          <div class="mt-auto space-y-4">
            <button
              id="macos-poll-button"
              class="w-full py-3 rounded-lg bg-black dark:bg-white text-white dark:text-black font-medium text-sm transition-colors hover:bg-gray-800 dark:hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {platforms.macos.pollButtonText}
            </button>
            <div class="text-center pt-2">
              <p class="text-xs text-gray-500">
                {platforms.macos.pollPrefix || "已有 "}<span
                  id="macos-poll-count"
                  class="font-bold">...</span
                >{platforms.macos.pollSuffix || " 位用户支持"}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          {downloadPage.footerMessage}
        </p>
      </div>
    </div>
  </section>

  <!-- Version History -->
  <VersionHistory versions={versions} />
</MainLayout>

<script is:inline define:vars={{ downloadPage }}>
  // Platform Interest Poll Logic
  document.addEventListener("DOMContentLoaded", () => {
    const platforms = [
      {
        id: "macos",
        buttonId: "macos-poll-button",
        countId: "macos-poll-count",
        storageKey: downloadPage.platforms.macos.storageKey,
        apiUrl: downloadPage.platforms.macos.poll.apiUrl,
      },
      {
        id: "linux",
        buttonId: "linux-poll-button",
        countId: "linux-poll-count",
        storageKey: downloadPage.platforms.linux.storageKey,
        apiUrl: downloadPage.platforms.linux.poll.apiUrl,
      },
    ];

    platforms.forEach((platform) => {
      const pollButton = document.getElementById(platform.buttonId);
      const pollCountLabel = document.getElementById(platform.countId);

      if (!pollButton || !pollCountLabel) return;

      async function updateCount() {
        try {
          const response = await fetch(`${platform.apiUrl}?t=${Date.now()}`);
          if (!response.ok) throw new Error("Fetch failed");
          const data = await response.json();
          pollCountLabel.textContent = data.count || "0";
        } catch (e) {
          pollCountLabel.textContent = "0"; // Fallback display
        }
      }

      async function handleVote() {
        if (localStorage.getItem(platform.storageKey)) return;

        try {
          const response = await fetch(platform.apiUrl, { method: "POST" });
          if (!response.ok) throw new Error("Post failed");
          const data = await response.json();
          pollCountLabel.textContent = data.count || "0";
          localStorage.setItem(platform.storageKey, "true");
          disableButton();
        } catch (e) {
          console.error(`${platform.id} Vote failed`, e);
        }
      }

      function disableButton() {
        pollButton.disabled = true;
        pollButton.textContent = "已提交意向";
        pollButton.classList.remove(
          "bg-black",
          "dark:bg-white",
          "hover:bg-gray-800",
          "dark:hover:bg-gray-200",
        );
        pollButton.classList.add(
          "bg-gray-200",
          "text-gray-500",
          "dark:bg-gray-800",
          "dark:text-gray-400",
        );
      }

      if (localStorage.getItem(platform.storageKey)) {
        disableButton();
      }
      pollButton.addEventListener("click", handleVote);
      updateCount();
    });
  });
</script>
