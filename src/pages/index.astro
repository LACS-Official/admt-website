---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import SimpleAnnouncementBanner from "@/components/SimpleAnnouncementBanner.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import StatsCounter from "@/components/StatsCounter";
import GroupModal from "@/components/GroupModal.astro";
---

<MainLayout
  title="首页"
  description={SITE_CONFIG.description}
  image={SITE_CONFIG.home.hero.bgImage || "/img/admt-bg.webp"}
>
  <ImageLightbox />

  <!-- Hero Section -->
  <section
    class="hero-section py-16 md:py-32 min-h-[50vh] flex items-center bg-white dark:bg-black relative"
  >
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 w-full pt-10"
    >
      <h1
        class="text-5xl sm:text-7xl md:text-8xl font-bold text-gray-900 dark:text-white mb-6 md:mb-8 tracking-tighter leading-[1.05]"
      >
        {SITE_CONFIG.name.split("-")[0]}<span
          class="text-gray-400 dark:text-gray-500 font-light"
          >{
            SITE_CONFIG.name.split("-")[1]
              ? "-" + SITE_CONFIG.name.split("-")[1]
              : ""
          }</span
        >
      </h1>
      <p
        class="text-lg sm:text-2xl text-gray-500 dark:text-gray-400 mb-10 md:mb-12 font-light leading-relaxed max-w-3xl mx-auto px-4"
      >
        {SITE_CONFIG.tagline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/download"
          class="bg-black dark:bg-white text-white dark:text-black px-8 md:px-10 py-3 md:py-4 rounded-full font-medium text-base md:text-lg transition-colors hover:bg-gray-800 dark:hover:bg-gray-200 block"
        >
          {SITE_CONFIG.home.hero.ctaDownload}
        </a>
        <a
          href="/features"
          class="group text-gray-900 bg-white border border-gray-200 dark:text-white dark:bg-black dark:border-gray-800 px-8 md:px-10 py-3 md:py-4 rounded-full font-medium text-base md:text-lg transition-colors hover:bg-gray-50 dark:hover:bg-gray-900 flex items-center justify-center gap-2 block"
        >
          {SITE_CONFIG.home.hero.ctaLearnMore}
          <svg
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Showcase -->
  <section
    class="py-16 md:py-24 bg-gray-50 dark:bg-gray-900/40 border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div class="order-2 md:order-1">
          <img
            src={SITE_CONFIG.home.showcase.image}
            alt={SITE_CONFIG.home.showcase.title}
            class="rounded-xl border border-gray-200 dark:border-gray-800 w-full"
          />
        </div>
        <div class="order-1 md:order-2">
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight"
          >
            {SITE_CONFIG.home.showcase.title}
          </h2>
          <p
            class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8"
          >
            {SITE_CONFIG.home.showcase.description}
          </p>
          <ul class="space-y-4">
            {
              SITE_CONFIG.home.showcase.features.map((item) => (
                <li class="flex items-center gap-3 text-base text-gray-700 dark:text-gray-300">
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Preview -->
  <section class="py-16 md:py-24 bg-white dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 tracking-tight"
          >
            {SITE_CONFIG.home.featuresPreview.title}
          </h2>
          <p
            class="text-base md:text-lg text-gray-500 dark:text-gray-400 max-w-xl"
          >
            {SITE_CONFIG.home.featuresPreview.subtitle}
          </p>
        </div>
        <div class="mt-6 md:mt-0">
          <a
            href="/features"
            class="group inline-flex items-center text-gray-900 dark:text-white font-medium text-sm md:text-base hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
          >
            {SITE_CONFIG.home.featuresPreview.viewAllText}
            <svg
              class="ml-2 w-4 h-4 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Feature Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {
          SITE_CONFIG.home.featuresPreview.items.map((feature) => (
            <div class="group border border-gray-200 dark:border-gray-800 rounded-xl bg-white dark:bg-gray-900/50 overflow-hidden">
              <div class="aspect-[16/10] overflow-hidden border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
                <img
                  src={feature.image}
                  alt={feature.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white tracking-tight mb-1">
                  {feature.title}
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {feature.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="py-12 md:py-20 bg-gray-50 dark:bg-gray-900/40 border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <StatsCounter client:visible />
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-20 md:py-32 bg-white dark:bg-black border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 md:mb-8 tracking-tight"
      >
        {SITE_CONFIG.home.cta.title}
      </h2>
      <p
        class="text-base md:text-xl text-gray-500 dark:text-gray-400 mb-10 font-light max-w-2xl mx-auto"
      >
        {SITE_CONFIG.home.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/download"
          class="bg-black text-white dark:bg-white dark:text-black px-8 sm:px-10 py-3 rounded-full text-base font-medium transition-colors hover:bg-gray-800 dark:hover:bg-gray-200"
        >
          {SITE_CONFIG.home.cta.downloadText}
        </a>
        <a
          href="/docs"
          class="bg-white text-gray-900 border border-gray-200 dark:bg-black dark:text-white dark:border-gray-800 px-8 sm:px-10 py-3 rounded-full text-base font-medium transition-colors hover:bg-gray-50 dark:hover:bg-gray-900"
        >
          {SITE_CONFIG.home.cta.docsText}
        </a>
      </div>
    </div>
  </section>

  <ImageLightbox />
  <GroupModal />
</MainLayout>
