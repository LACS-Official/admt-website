---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import SimpleAnnouncementBanner from "@/components/SimpleAnnouncementBanner.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import StatsCounter from "@/components/StatsCounter";
import GroupModal from "@/components/GroupModal.astro";
import AppleScrollEffects from "@/components/AppleScrollEffects.astro";
---

<MainLayout
  title="首页"
  description={SITE_CONFIG.description}
  image={SITE_CONFIG.home.hero.bgImage || "/img/admt-bg.webp"}
>
  <ImageLightbox />
  <AppleScrollEffects />

  <!-- Hero Section -->
  <section
    class="hero-section py-20 md:py-40 min-h-[70vh] flex items-center bg-white dark:bg-black relative overflow-hidden"
  >
    <!-- Background Parallax Elements -->
    <div
      class="absolute inset-0 -z-10 pointer-events-none"
      data-parallax="0.15"
    >
      <div class="absolute top-[10%] left-[5%] w-[30%] h-[30%] rounded-full bg-blue-500/5 blur-[100px] dark:bg-blue-600/10 animate-pulse"></div>
      <div class="absolute bottom-[10%] right-[5%] w-[35%] h-[35%] rounded-full bg-purple-500/5 blur-[120px] dark:bg-purple-600/10 animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[radial-gradient(circle_at_center,rgba(0,0,0,0)_0%,rgba(255,255,255,0.8)_100%)] dark:bg-[radial-gradient(circle_at_center,rgba(255,255,255,0)_0%,rgba(0,0,0,0.8)_100%)]"></div>
    </div>

    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 w-full"
      data-fade-in
    >
      <div data-parallax="0.02" class="mb-6 flex justify-center">
        <a
          href={SITE_CONFIG.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-4.5 py-2 rounded-full bg-gray-100/80 dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 backdrop-blur-md text-xs sm:text-sm font-medium text-gray-800 dark:text-gray-200 hover:border-gray-400 dark:hover:border-gray-500 hover:scale-105 transition-all duration-300 shadow-sm"
        >
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>🎉 ADMT 现已全面开源</span>
          <span class="text-gray-400 dark:text-gray-500">•</span>
          <span class="inline-flex items-center gap-1 group-hover:text-black dark:group-hover:text-white transition-colors">
            前往 GitHub 仓库
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </span>
        </a>
      </div>

      <div data-parallax="0.05">
        <h1
          class="text-6xl sm:text-8xl md:text-9xl font-bold text-gray-900 dark:text-white mb-8 md:mb-10 tracking-tighter leading-[1.05]"
        >
          {SITE_CONFIG.name.split("-")[0]}<span
            class="text-gray-300 dark:text-gray-600 font-extralight"
            >{
              SITE_CONFIG.name.split("-")[1]
                ? "-" + SITE_CONFIG.name.split("-")[1]
                : ""
            }</span
          >
        </h1>
      </div>
      
      <div data-parallax="0.1">
        <p
          class="text-2xl sm:text-3xl md:text-4xl text-gray-800 dark:text-gray-200 mb-4 font-semibold tracking-tight leading-relaxed max-w-4xl mx-auto px-4"
        >
          {SITE_CONFIG.tagline}
        </p>
        <p
          class="text-lg sm:text-xl md:text-2xl text-gray-500 dark:text-gray-400 mb-12 md:mb-16 font-light leading-relaxed max-w-3xl mx-auto px-4"
        >
          {SITE_CONFIG.subtitle}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center" data-parallax="0.15">
        <a
          href="/download"
          class="bg-black dark:bg-white text-white dark:text-black px-8 md:px-10 py-4 md:py-5 rounded-full font-semibold text-lg md:text-xl transition-all hover:scale-105 hover:shadow-2xl active:scale-95 w-full sm:w-auto text-center"
        >
          {SITE_CONFIG.home.hero.ctaDownload}
        </a>
        <a
          href={SITE_CONFIG.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group text-gray-900 bg-white/80 backdrop-blur-md border border-gray-200 dark:text-white dark:bg-black/50 dark:border-gray-800 px-8 md:px-10 py-4 md:py-5 rounded-full font-semibold text-lg md:text-xl transition-all hover:bg-gray-50 dark:hover:bg-gray-900 hover:scale-105 flex items-center justify-center gap-2.5 w-full sm:w-auto"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          GitHub 源码
        </a>
        <a
          href="/features"
          class="group text-gray-900 bg-white/80 backdrop-blur-md border border-gray-200 dark:text-white dark:bg-black/50 dark:border-gray-800 px-8 md:px-10 py-4 md:py-5 rounded-full font-semibold text-lg md:text-xl transition-all hover:bg-gray-50 dark:hover:bg-gray-900 hover:scale-105 flex items-center justify-center gap-2 w-full sm:w-auto"
        >
          {SITE_CONFIG.home.hero.ctaLearnMore}
          <svg
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Showcase -->
  <section
    class="py-16 md:py-24 bg-gray-50 dark:bg-gray-900/40 border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div class="order-2 md:order-1">
          <img
            src={SITE_CONFIG.home.showcase.image}
            alt={SITE_CONFIG.home.showcase.title}
            class="rounded-xl border border-gray-200 dark:border-gray-800 w-full"
          />
        </div>
        <div class="order-1 md:order-2">
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight"
          >
            {SITE_CONFIG.home.showcase.title}
          </h2>
          <p
            class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8"
          >
            {SITE_CONFIG.home.showcase.description}
          </p>
          <ul class="space-y-4">
            {
              SITE_CONFIG.home.showcase.features.map((item) => (
                <li class="flex items-center gap-3 text-base text-gray-700 dark:text-gray-300">
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Preview -->
  <section class="py-16 md:py-24 bg-white dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 tracking-tight"
          >
            {SITE_CONFIG.home.featuresPreview.title}
          </h2>
          <p
            class="text-base md:text-lg text-gray-500 dark:text-gray-400 max-w-xl"
          >
            {SITE_CONFIG.home.featuresPreview.subtitle}
          </p>
        </div>
        <div class="mt-6 md:mt-0">
          <a
            href="/features"
            class="group inline-flex items-center text-gray-900 dark:text-white font-medium text-sm md:text-base hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
          >
            {SITE_CONFIG.home.featuresPreview.viewAllText}
            <svg
              class="ml-2 w-4 h-4 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Feature Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {
          SITE_CONFIG.home.featuresPreview.items.map((feature) => (
            <div class="group border border-gray-200 dark:border-gray-800 rounded-xl bg-white dark:bg-gray-900/50 overflow-hidden">
              <div class="aspect-[16/10] overflow-hidden border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
                <img
                  src={feature.image}
                  alt={feature.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white tracking-tight mb-1">
                  {feature.title}
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {feature.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="py-12 md:py-20 bg-gray-50 dark:bg-gray-900/40 border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <StatsCounter client:visible />
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-20 md:py-32 bg-white dark:bg-black border-t border-gray-100 dark:border-gray-800"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 md:mb-8 tracking-tight"
      >
        {SITE_CONFIG.home.cta.title}
      </h2>
      <p
        class="text-base md:text-xl text-gray-500 dark:text-gray-400 mb-10 font-light max-w-2xl mx-auto"
      >
        {SITE_CONFIG.home.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/download"
          class="bg-black text-white dark:bg-white dark:text-black px-8 sm:px-10 py-3 rounded-full text-base font-medium transition-colors hover:bg-gray-800 dark:hover:bg-gray-200"
        >
          {SITE_CONFIG.home.cta.downloadText}
        </a>
        <a
          href={SITE_CONFIG.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-gray-900 border border-gray-200 dark:bg-black dark:text-white dark:border-gray-800 px-8 sm:px-10 py-3 rounded-full text-base font-medium transition-colors hover:bg-gray-50 dark:hover:bg-gray-900 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          GitHub 仓库
        </a>
        <a
          href="/docs"
          class="bg-white text-gray-900 border border-gray-200 dark:bg-black dark:text-white dark:border-gray-800 px-8 sm:px-10 py-3 rounded-full text-base font-medium transition-colors hover:bg-gray-50 dark:hover:bg-gray-900"
        >
          {SITE_CONFIG.home.cta.docsText}
        </a>
      </div>
    </div>
  </section>

  <ImageLightbox />
  <GroupModal />
</MainLayout>
