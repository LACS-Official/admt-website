---
import { SITE_CONFIG } from "@/config/site";
---

<div
  id="group-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-gray-900/40 backdrop-blur-md transition-all duration-500 opacity-0"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Background Glows -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-[20%] left-[30%] w-64 h-64 bg-blue-500/20 rounded-full blur-[100px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-[20%] right-[30%] w-64 h-64 bg-indigo-500/20 rounded-full blur-[100px] animate-pulse"
      style="animation-delay: 1s"
    >
    </div>
  </div>

  <div
    class="relative transform overflow-hidden rounded-[2.5rem] bg-white/80 dark:bg-black/80 backdrop-blur-2xl border border-white/20 dark:border-white/10 text-left shadow-[0_32px_64px_-16px_rgba(0,0,0,0.3)] transition-all sm:my-8 sm:w-full sm:max-w-md animate-modal-in"
  >
    <!-- Top Pattern/Glow -->
    <div
      class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-blue-500/10 to-transparent pointer-events-none"
    >
    </div>

    <div class="px-8 pt-10 pb-8 relative">
      <div class="flex flex-col items-center text-center">
        <h3
          class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white mb-3"
          id="modal-title"
        >
          {SITE_CONFIG.group.name}
        </h3>

        <p
          class="text-gray-500 dark:text-gray-400 text-base leading-relaxed px-4"
        >
          {SITE_CONFIG.group.description}
        </p>

        <!-- QR Code Card -->
        <div
          class="mt-8 p-1.5 rounded-[2rem] bg-gray-100/50 dark:bg-white/5 border border-white/20 dark:border-white/5"
        >
          <div class="bg-white p-4 rounded-[1.8rem] shadow-inner">
            <img
              src={SITE_CONFIG.group.qrCode}
              alt="QR Code"
              class="w-48 h-48 object-contain"
              onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(window.location.href)"
            />
          </div>
        </div>

        <div class="mt-3 text-sm font-medium text-gray-400 dark:text-gray-500">
          群号：<span
            class="text-blue-600 dark:text-blue-400 font-bold tracking-wider"
            >{SITE_CONFIG.group.number}</span
          >
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-col w-full space-y-4">
          <a
            href={SITE_CONFIG.group.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-full py-4 px-6 rounded-2xl bg-black dark:bg-white text-white dark:text-black font-bold text-lg hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-black/10 dark:shadow-white/5"
          >
            {SITE_CONFIG.group.joinButtonText}
          </a>

          <div class="flex items-center gap-3 w-full">
            <button
              type="button"
              class="close-modal-button flex-1 py-3 px-6 rounded-2xl bg-gray-100 dark:bg-white/5 text-gray-600 dark:text-gray-400 font-semibold text-sm hover:bg-gray-200 dark:hover:bg-white/10 transition-all"
            >
              {SITE_CONFIG.group.closeButtonText}
            </button>
            <button
              type="button"
              class="permanently-hide-button py-3 px-6 rounded-2xl text-gray-400 dark:text-gray-600 font-medium text-xs hover:text-gray-600 dark:hover:text-gray-400 transition-all underline underline-offset-4"
            >
              不再提示
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Top-level Close X -->
    <button
      type="button"
      class="close-modal-button absolute top-6 right-6 p-2 rounded-full text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-all"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  function setupModal() {
    const modal = document.getElementById("group-modal");
    if (!modal) return;

    const openButtons = document.querySelectorAll(".open-group-modal");
    const closeButtons = document.querySelectorAll(".close-modal-button");
    const permanentHideBtn = modal.querySelector(".permanently-hide-button");

    const STORAGE_KEY = "hide_group_modal_permanently_v1";

    const showModal = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => {
        modal.classList.add("opacity-100");
      });
    };

    const hideModal = (permanently = false) => {
      modal.classList.remove("opacity-100");
      document.body.style.overflow = "";
      if (permanently) {
        localStorage.setItem(STORAGE_KEY, "true");
      }
      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }, 500);
    };

    openButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        showModal();
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener("click", () => hideModal(false));
    });

    permanentHideBtn?.addEventListener("click", () => hideModal(true));

    // Close on click outside
    modal.addEventListener("click", (e) => {
      if (e.target === modal) hideModal(false);
    });

    // Close on escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        hideModal(false);
      }
    });

    // Auto-show logic
    const isPermanentlyHidden = localStorage.getItem(STORAGE_KEY);
    if (!isPermanentlyHidden) {
      setTimeout(showModal, 1500);
    }
  }

  // Handle both initial load and view transitions
  setupModal();
  document.addEventListener("astro:page-load", setupModal);
</script>

<style>
  @keyframes modal-in {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .animate-modal-in {
    animation: modal-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
