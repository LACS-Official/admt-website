---
import { SITE_CONFIG } from "@/config/site";
---

<footer
  class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center space-x-2 mb-4">
          <img
            src="/favicon.png"
            alt={SITE_CONFIG.name}
            class="w-8 h-8 rounded-lg"
          />
          <span class="font-bold text-xl text-gray-900 dark:text-white">
            {SITE_CONFIG.name}
          </span>
        </div>
        <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-md">
          {SITE_CONFIG.description}
        </p>
        <div class="flex space-x-4">
          <a
            href={`mailto:${SITE_CONFIG.social.email}`}
            class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200"
          >
            {SITE_CONFIG.social.email}
          </a>
        </div>
      </div>

      <!-- Dynamic Sections -->
      {
        SITE_CONFIG.footer.sections.map((section) => (
          <div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
              {section.title}
            </h3>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom section -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-600 dark:text-gray-400 text-sm">
          {SITE_CONFIG.copyright}
        </p>
        <div class="mt-4 md:mt-0 flex space-x-6">
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.icp}
          </span>
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.police}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
