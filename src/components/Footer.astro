---
import { SITE_CONFIG } from "@/config/site";

const sectionTitleKeys: Record<string, string> = {
  "产品": "footerColProduct",
  "开源与支持": "footerColSupport",
  "协议政策": "footerColPolicies",
};

const linkKeys: Record<string, string> = {
  "功能特性": "navFeatures",
  "下载": "navDownload",
  "GitHub 源码": "footerGithubSrc",
  "文档": "navDocs",
  "联系我们": "footerContact",
  "GitHub 仓库": "footerGithubRepo",
  "用户协议": "footerAgreementUser",
  "隐私政策": "footerAgreementPrivacy",
  "信息收集说明": "footerAgreementCollection",
};
---

<footer
  class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center space-x-2 mb-4">
          <img
            src="/favicon.png"
            alt={SITE_CONFIG.name}
            class="w-8 h-8 rounded-lg"
          />
          <span class="font-bold text-xl text-gray-900 dark:text-white" data-i18n-key="siteName">
            {SITE_CONFIG.name}
          </span>
        </div>
        <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-md" data-i18n-key="siteDescription">
          {SITE_CONFIG.description}
        </p>
        <div class="flex items-center space-x-4">
          <a
            href={`mailto:${SITE_CONFIG.social.email}`}
            class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200 text-sm"
          >
            {SITE_CONFIG.social.email}
          </a>
          <span class="text-gray-300 dark:text-gray-700">•</span>
          <a
            href={SITE_CONFIG.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors duration-200 text-sm font-medium"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span data-i18n-key="footerGithubSrc">GitHub 源码</span>
          </a>
        </div>
      </div>

      <!-- Dynamic Sections -->
      {
        SITE_CONFIG.footer.sections.map((section) => (
          <div>
            <h3 
              class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4"
              data-i18n-key={sectionTitleKeys[section.title]}
            >
              {section.title}
            </h3>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200"
                    data-i18n-key={linkKeys[link.name]}
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom section -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-600 dark:text-gray-400 text-sm" data-i18n-key="copyright">
          {SITE_CONFIG.copyright}
        </p>
        <div class="mt-4 md:mt-0 flex space-x-6">
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.icp}
          </span>
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.police}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
        <div class="mt-4 md:mt-0 flex space-x-6">
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.icp}
          </span>
          <span class="text-gray-600 dark:text-gray-400 text-sm">
            {SITE_CONFIG.beian.police}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
